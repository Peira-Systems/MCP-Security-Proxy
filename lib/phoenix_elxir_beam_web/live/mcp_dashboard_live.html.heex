<Layouts.app flash={@flash}>
  <div class="space-y-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">MCP Security Proxy</h1>
        <p class="mt-1 text-sm text-base-content/70">
          Watch tool calls flow from a simulated agent through the policy-enforcing proxy to
          two mock MCP servers. A dangerous tool-chain — reading a secret, then posting it to
          the network — lights up red and is blocked before it ever reaches the server.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <.link navigate={~p"/mcp/logs"} class="btn btn-ghost btn-sm">
          Event log
        </.link>
        <button
          id="run-benign-btn"
          type="button"
          phx-click="run_benign"
          disabled={@running}
          class="btn btn-outline"
        >
          Run benign session
        </button>
        <button
          id="run-attack-btn"
          type="button"
          phx-click="run_attack"
          disabled={@running}
          class="btn btn-primary"
        >
          Run attack simulation
        </button>
      </div>
    </div>

    <div class="flex items-center gap-2 text-sm">
      <span class="text-base-content/60">Status:</span>
      <span :if={@running} class="inline-flex items-center gap-1.5 font-medium text-primary">
        <span class="size-2 animate-pulse rounded-full bg-primary"></span>
        running {@scenario && "(#{@scenario})"}
      </span>
      <span :if={!@running} class="text-base-content/60">idle</span>
    </div>

    <div
      id="mcp-tool-graph"
      phx-hook=".ToolGraph"
      phx-update="ignore"
      class="rounded-box border border-base-300 bg-base-100 p-2"
    >
      <svg viewBox="0 0 900 480" class="h-[420px] w-full">
        <g>
          <% {ax, ay} = @positions["agent"] %>
          <% {gx, gy} = @positions["gate"] %>
          <line
            id="edge-agent-gate"
            data-from="agent"
            data-to="gate"
            class="mcp-edge stroke-base-content/25 transition-[stroke,stroke-width] duration-300 [stroke-width:2px]"
            x1={ax}
            y1={ay}
            x2={gx}
            y2={gy}
          />
          <%= for %{id: server_id} <- @graph do %>
            <% {sx, sy} = @positions["server-" <> server_id] %>
            <line
              id={"edge-gate-server-" <> server_id}
              data-from="gate"
              data-to={"server-" <> server_id}
              class="mcp-edge stroke-base-content/25 transition-[stroke,stroke-width] duration-300 [stroke-width:2px]"
              x1={gx}
              y1={gy}
              x2={sx}
              y2={sy}
            />
          <% end %>
          <%= for %{id: server_id, tools: tools} <- @graph, tool <- tools do %>
            <% {sx, sy} = @positions["server-" <> server_id] %>
            <% {tx, ty} = @positions["tool-" <> tool.name] %>
            <line
              id={"edge-server-" <> server_id <> "-tool-" <> tool.name}
              data-from={"server-" <> server_id}
              data-to={"tool-" <> tool.name}
              class="mcp-edge stroke-base-content/25 transition-[stroke,stroke-width] duration-300 [stroke-width:2px]"
              x1={sx}
              y1={sy}
              x2={tx}
              y2={ty}
            />
          <% end %>
        </g>

        <g>
          <g
            id="node-agent"
            data-key="agent"
            class="mcp-node"
            transform={"translate(#{ax},#{ay})"}
          >
            <circle r="24" class="mcp-node-shape fill-primary" />
            <text
              text-anchor="middle"
              dy="4"
              class="fill-primary-content text-[10px] font-semibold"
            >
              agent
            </text>
          </g>

          <g id="node-gate" data-key="gate" class="mcp-node" transform={"translate(#{gx},#{gy})"}>
            <polygon
              points="0,-20 20,0 0,20 -20,0"
              class="mcp-node-shape fill-base-100 stroke-base-content/40 [stroke-width:2px] transition-colors duration-300"
            />
            <path
              d="M-4,-3 a4,4 0 0 1 8,0"
              class="fill-none stroke-base-content/60 [stroke-width:1.3px]"
            />
            <rect x="-5" y="-3" width="10" height="7" rx="1.5" class="fill-base-content/60" />
            <text
              text-anchor="middle"
              dy="34"
              class="fill-base-content/70 text-[10px] font-medium"
            >
              policy gate
            </text>
          </g>

          <%= for %{id: server_id} <- @graph do %>
            <% {sx, sy} = @positions["server-" <> server_id] %>
            <g
              id={"node-server-" <> server_id}
              data-key={"server-" <> server_id}
              class="mcp-node"
              transform={"translate(#{sx},#{sy})"}
            >
              <rect
                x="-42"
                y="-18"
                width="84"
                height="36"
                rx="9"
                class="mcp-node-shape fill-base-100 stroke-base-content/40 [stroke-width:2px] transition-colors duration-300"
              />
              <line
                x1="-32"
                y1="-8"
                x2="-18"
                y2="-8"
                class="stroke-base-content/40 [stroke-width:1.2px]"
              />
              <line
                x1="-32"
                y1="-2"
                x2="-18"
                y2="-2"
                class="stroke-base-content/40 [stroke-width:1.2px]"
              />
              <line
                x1="-32"
                y1="4"
                x2="-18"
                y2="4"
                class="stroke-base-content/40 [stroke-width:1.2px]"
              />
              <text
                x="8"
                text-anchor="middle"
                dy="4"
                class="fill-base-content text-[11px] font-semibold"
              >
                {server_id}
              </text>
            </g>
          <% end %>

          <%= for %{id: server_id, tools: tools} <- @graph, tool <- tools do %>
            <% {tx, ty} = @positions["tool-" <> tool.name] %>
            <g
              id={"node-tool-" <> tool.name}
              data-key={"tool-" <> tool.name}
              class="mcp-node"
              transform={"translate(#{tx},#{ty})"}
            >
              <rect
                x="-46"
                y="-14"
                width="92"
                height="28"
                rx="14"
                class={[
                  "mcp-node-shape stroke-base-content/30 [stroke-width:1.5px] transition-colors duration-300",
                  if(tool.tags != [], do: "fill-warning/10", else: "fill-base-200")
                ]}
              />
              <circle
                :if={:sensitive_read in tool.tags}
                cx="-36"
                cy="-9"
                r="3.5"
                class="fill-warning"
              />
              <circle
                :if={:network_egress in tool.tags}
                cx="36"
                cy="-9"
                r="3.5"
                class="fill-none stroke-error [stroke-width:1.3px]"
              />
              <text text-anchor="middle" dy="4" class="fill-base-content text-[10px] font-medium">
                {tool.name}
              </text>
            </g>
          <% end %>
        </g>

        <circle id="graph-pulse-dot" r="5" class="opacity-0 transition-opacity duration-150" />

        <text
          id="graph-reason-label"
          text-anchor="middle"
          x="450"
          y="465"
          class="fill-error text-[12px] font-medium opacity-0 transition-opacity duration-300"
        >
        </text>
      </svg>
    </div>

    <div>
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-base-content/70">Event feed</h2>
        <button type="button" phx-click="clear_feed" class="btn btn-ghost btn-xs">
          Clear feed
        </button>
      </div>
      <div id="mcp-event-feed" phx-update="stream" class="mt-2 space-y-1">
        <div
          id="mcp-event-feed-empty"
          class="hidden only:block rounded-box border border-dashed border-base-300 p-4 text-center text-sm text-base-content/50"
        >
          No events yet — run a scenario to see tool calls appear here.
        </div>
        <div
          :for={{dom_id, event} <- @streams.events}
          id={dom_id}
          class="flex items-center gap-3 rounded-box border border-base-300 bg-base-100 px-3 py-2 text-sm"
        >
          <span class="w-20 shrink-0 font-mono text-xs text-base-content/50">
            {format_time(event.timestamp)}
          </span>
          <span class={[
            "shrink-0 rounded-full px-2 py-0.5 text-xs font-medium",
            status_badge_class(event.status)
          ]}>
            {status_label(event.status)}
          </span>
          <span class="flex-1 truncate">
            <span :if={event.server_id} class="font-mono text-xs text-base-content/70">
              {event.server_id}/{event.tool_name}
            </span>
            <span :if={event.reason} class="ml-2 text-error">{event.reason}</span>
          </span>
          <span class="shrink-0 text-xs text-base-content/40">{event.scenario}</span>
        </div>
      </div>
    </div>

    <div class="space-y-4 border-t border-base-300 pt-8">
      <div>
        <h2 class="text-lg font-semibold tracking-tight">Real MCP servers</h2>
        <p class="mt-1 text-sm text-base-content/70">
          Register a real MCP server — over Streamable HTTP, or spawned locally and spoken to
          over stdio — to discover its tools. Tag which tools are sensitive reads or network
          egress, then call them through the same policy-enforcing proxy — calls that reach a
          real server here are real, not simulated.
        </p>
      </div>

      <.form
        for={to_form(%{})}
        id="register-server-form"
        phx-submit="register_server"
        class="flex flex-wrap items-end gap-3"
      >
        <div class="min-w-[10rem] flex-1">
          <label class="text-xs font-medium text-base-content/60" for="register-server-name">
            Name
          </label>
          <input
            id="register-server-name"
            type="text"
            name="name"
            placeholder="My filesystem server"
            class="input input-bordered input-sm w-full"
          />
        </div>
        <div class="min-w-[16rem] flex-[2]">
          <label class="text-xs font-medium text-base-content/60" for="register-server-url">
            Base URL
          </label>
          <input
            id="register-server-url"
            type="text"
            name="base_url"
            placeholder="http://localhost:9000/mcp"
            class="input input-bordered input-sm w-full"
          />
        </div>
        <button type="submit" disabled={@registering} class="btn btn-primary btn-sm">
          {if @registering, do: "Registering…", else: "Register server"}
        </button>
      </.form>

      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs text-base-content/60">Or spawn a real stdio server:</span>
        <button
          type="button"
          phx-click="register_stdio_preset"
          phx-value-preset="filesystem"
          disabled={@registering}
          class="btn btn-outline btn-xs"
        >
          + real filesystem server
        </button>
        <button
          type="button"
          phx-click="register_stdio_preset"
          phx-value-preset="fetch"
          disabled={@registering}
          class="btn btn-outline btn-xs"
        >
          + real fetch server
        </button>
      </div>

      <div class="flex items-center gap-2 text-xs text-base-content/60">
        <span>Manual call session:</span>
        <span class="font-mono">{@manual_session_id}</span>
        <button type="button" phx-click="new_manual_session" class="btn btn-ghost btn-xs">
          New session
        </button>
      </div>

      <div
        :if={@real_servers == []}
        class="rounded-box border border-dashed border-base-300 p-4 text-center text-sm text-base-content/50"
      >
        No real servers registered yet.
      </div>

      <div
        :for={server <- @real_servers}
        id={"real-server-" <> server.id}
        class="space-y-3 rounded-box border border-base-300 bg-base-100 p-4"
      >
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h3 class="font-semibold">{server.name}</h3>
          </div>
          <button
            type="button"
            phx-click="remove_server"
            phx-value-server_id={server.id}
            class="btn btn-ghost btn-xs shrink-0 text-error"
          >
            Remove
          </button>
        </div>

        <div class="space-y-2">
          <div
            :for={tool <- server.tools}
            class="flex flex-wrap items-center gap-2 rounded-box bg-base-200/50 px-3 py-2 text-sm"
          >
            <span class="font-mono font-medium">{tool.name}</span>
            <span class="text-xs text-base-content/60">{tool.description}</span>
            <span class="ml-auto flex items-center gap-1.5">
              <button
                type="button"
                phx-click="toggle_tool_tag"
                phx-value-server_id={server.id}
                phx-value-tool_name={tool.name}
                phx-value-tag="sensitive_read"
                class={[
                  "rounded-full px-2 py-0.5 text-xs font-medium transition-colors",
                  if(:sensitive_read in tool.tags,
                    do: "bg-warning/20 text-warning",
                    else: "bg-base-300 text-base-content/50"
                  )
                ]}
              >
                sensitive read
              </button>
              <button
                type="button"
                phx-click="toggle_tool_tag"
                phx-value-server_id={server.id}
                phx-value-tool_name={tool.name}
                phx-value-tag="network_egress"
                class={[
                  "rounded-full px-2 py-0.5 text-xs font-medium transition-colors",
                  if(:network_egress in tool.tags,
                    do: "bg-error/20 text-error",
                    else: "bg-base-300 text-base-content/50"
                  )
                ]}
              >
                network egress
              </button>
            </span>
          </div>
        </div>

        <.form
          for={to_form(%{})}
          id={"call-tool-form-" <> server.id}
          phx-submit="call_tool"
          class="flex flex-wrap items-end gap-2 border-t border-base-300 pt-3"
        >
          <input type="hidden" name="server_id" value={server.id} />
          <select name="tool_name" class="select select-bordered select-sm">
            <option :for={tool <- server.tools} value={tool.name}>{tool.name}</option>
          </select>
          <input
            type="text"
            name="arguments"
            placeholder={~s({"key": "value"})}
            class="input input-bordered input-sm flex-1 font-mono"
          />
          <button type="submit" class="btn btn-sm btn-outline">Call tool</button>
        </.form>
      </div>
    </div>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".ToolGraph">
    export default {
      mounted() {
        this.pulseToken = 0
        this.handleEvent("mcp_graph_reset", () => this.reset())
        this.handleEvent("mcp_graph_event", (payload) => this.pulse(payload))
      },

      // Layout is fixed server-side now — no relaxation pass. Node
      // coordinates are read straight off each node's `transform`.
      nodeXY(key) {
        const el = this.el.querySelector(`.mcp-node[data-key="${key}"]`)
        if (!el) return null
        const match = /translate\(([-\d.]+),([-\d.]+)\)/.exec(el.getAttribute("transform") || "")
        return match ? { x: parseFloat(match[1]), y: parseFloat(match[2]) } : null
      },

      reset() {
        this.pulseToken++
        this.el.querySelectorAll(".mcp-edge").forEach((el) => {
          el.classList.remove("stroke-primary", "stroke-error", "[stroke-width:3px]", "[stroke-dasharray:6_4]")
        })
        this.el.querySelectorAll(".mcp-node-shape").forEach((el) => {
          el.classList.remove("stroke-primary", "stroke-error", "fill-error/20", "[stroke-width:3px]")
        })
        const dot = this.el.querySelector("#graph-pulse-dot")
        if (dot) dot.classList.add("opacity-0")
        const label = this.el.querySelector("#graph-reason-label")
        if (label) {
          label.textContent = ""
          label.classList.add("opacity-0")
        }
      },

      // Walks the dot agent → gate → server → tool. A blocked call still
      // travels the first two hops (it was a real, permitted request up to
      // that point) and then stops partway into the tool hop — the call
      // never actually reached the tool.
      async pulse({ server_id, tool_name, status, reason }) {
        const token = ++this.pulseToken
        const serverKey = `server-${server_id}`
        const toolKey = `tool-${tool_name}`
        const blocked = status === "blocked"

        await this.travel("agent", "gate", false, 1, token)
        if (token !== this.pulseToken) return
        this.flashNode("gate", false)

        await this.travel("gate", serverKey, false, 1, token)
        if (token !== this.pulseToken) return
        this.flashNode(serverKey, false)

        await this.travel(serverKey, toolKey, blocked, blocked ? 0.55 : 1, token)
        if (token !== this.pulseToken) return

        if (blocked) {
          const toolEdge = this.el.querySelector(`#edge-server-${serverKey}-tool-${toolKey}`)
          const toolShape = this.el.querySelector(`#node-${toolKey} .mcp-node-shape`)
          if (toolEdge) toolEdge.classList.add("stroke-error", "[stroke-width:3px]", "[stroke-dasharray:6_4]")
          if (toolShape) toolShape.classList.add("stroke-error", "fill-error/20", "[stroke-width:3px]")
          this.flashNode(serverKey, true)
          this.flashNode("gate", true)

          const label = this.el.querySelector("#graph-reason-label")
          if (label) {
            label.textContent = reason || "blocked"
            label.classList.remove("opacity-0")
          }
        } else {
          this.flashNode(toolKey, false)
        }
      },

      travel(fromKey, toKey, blocked, t, token) {
        return new Promise((resolve) => {
          const from = this.nodeXY(fromKey)
          const to = this.nodeXY(toKey)
          const dot = this.el.querySelector("#graph-pulse-dot")
          if (!from || !to || !dot) return resolve()

          dot.classList.remove("fill-primary", "fill-error", "opacity-0")
          if (blocked) dot.classList.add("fill-error")
          else dot.classList.add("fill-primary")

          const duration = 180
          const start = performance.now()

          const frame = (now) => {
            if (token !== this.pulseToken) return resolve()

            const progress = Math.min(1, (now - start) / duration) * t
            dot.setAttribute("cx", from.x + (to.x - from.x) * progress)
            dot.setAttribute("cy", from.y + (to.y - from.y) * progress)

            if (now - start < duration) {
              requestAnimationFrame(frame)
            } else {
              dot.classList.add("opacity-0")
              resolve()
            }
          }
          requestAnimationFrame(frame)
        })
      },

      flashNode(key, blocked) {
        const shape = this.el.querySelector(`.mcp-node[data-key="${key}"] .mcp-node-shape`)
        if (!shape) return
        const cls = blocked ? "stroke-error" : "stroke-primary"
        shape.classList.add(cls, "[stroke-width:3px]")
        setTimeout(() => shape.classList.remove(cls, "[stroke-width:3px]"), 450)
      }
    }
  </script>
</Layouts.app>
