# Normalize line endings to LF regardless of the OS a clone/checkout happens
# on. Without this, files committed with CRLF (e.g. from a Windows checkout)
# stay CRLF forever, tripping `mix format --check-formatted` and other
# tooling on Linux/macOS.
* text=auto eol=lf

*.ex text eol=lf
*.exs text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
