# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored — never commit real secrets.

# Secret used to sign/encrypt cookies and other secrets. Generate one with:
#   mix phx.gen.secret
SECRET_KEY_BASE=

# Public hostname the app is served from (used for URL generation).
PHX_HOST=localhost

# HTTP Basic auth for the dashboard and /dev tools. DASHBOARD_PASSWORD is
# required in prod.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Port the app listens on inside the container, and the host port it's
# published on (docker-compose maps them 1:1).
PORT=4000

# Ecto/SQLite connection pool size.
POOL_SIZE=5

# Optional: DNS query used by dns_cluster for node clustering. Leave blank
# for a single-node deployment.
DNS_CLUSTER_QUERY=
