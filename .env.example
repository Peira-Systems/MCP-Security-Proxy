# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored — never commit real secrets.

# Secret used to sign/encrypt cookies and other secrets. Generate one with:
#   mix phx.gen.secret
SECRET_KEY_BASE=

# Public hostname the app is served from (used for URL generation).
PHX_HOST=localhost

# HTTP Basic auth for the dashboard and /dev tools. DASHBOARD_PASSWORD is
# required in prod.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Optional: let Bandit terminate TLS directly (otherwise a reverse proxy in
# front handles it). Set both to enable an https listener.
# SSL_CERT_PATH=/etc/ssl/certs/app.pem
# SSL_KEY_PATH=/etc/ssl/private/app.key
# SSL_PORT=443

# Port the app listens on inside the container, and the host port it's
# published on (docker-compose maps them 1:1).
PORT=4000

# Postgres. The compose file builds DATABASE_URL for the app from these;
# POSTGRES_PASSWORD is required.
POSTGRES_USER=mcp_proxy
POSTGRES_PASSWORD=
POSTGRES_DB=mcp_proxy
# Host port the postgres service is published on (for local psql / mix).
POSTGRES_PORT=5432

# Ecto connection pool size.
POOL_SIZE=10

# HMAC key for the off-DB audit-chain checkpoints (M2.3). Generate with
# `mix phx.gen.secret 32`. Must be stable across deploys.
AUDIT_CHECKPOINT_KEY=

# Optional: DNS query used by dns_cluster for node clustering. Leave blank
# for a single-node deployment.
DNS_CLUSTER_QUERY=
