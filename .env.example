# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored — never commit real secrets.
#
# The three actual secrets are NOT here — they are Docker secret files under
# secrets/ (M3.4d), read from /run/secrets/* by config/runtime.exs:
#   mkdir -p secrets
#   openssl rand -hex 64    > secrets/secret_key_base.txt      # or: mix phx.gen.secret
#   openssl rand -hex 32    > secrets/audit_checkpoint_key.txt # stable across deploys
#   openssl rand -base64 24 > secrets/postgres_password.txt

# Public hostname the app is served from (used for URL generation).
PHX_HOST=localhost

# First-run operator admin (M3.4). Seeded only when the users table is empty;
# manage further accounts from the dashboard afterwards. Set both on the first
# deploy.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional: let Bandit terminate TLS directly (otherwise a reverse proxy in
# front handles it). Set both to enable an https listener.
# SSL_CERT_PATH=/etc/ssl/certs/app.pem
# SSL_KEY_PATH=/etc/ssl/private/app.key
# SSL_PORT=443

# Port the app listens on inside the container, and the host port it's
# published on (docker-compose maps them 1:1).
PORT=4000

# Postgres identity. The password is the postgres_password Docker secret;
# runtime.exs builds DATABASE_URL from these + that secret.
POSTGRES_USER=mcp_proxy
POSTGRES_DB=mcp_proxy
# Host port the postgres service is published on (for local psql / mix).
POSTGRES_PORT=5432

# Ecto connection pool size.
POOL_SIZE=10

# Observability (M3.2). Optional bearer token for GET /metrics — leave blank
# if the endpoint is only reachable from the scrape network.
METRICS_TOKEN=
# GET /health/ready returns 503 when a registered upstream is unreachable.
# Set to false to make upstream reachability advisory (DB-only readiness).
READINESS_REQUIRE_UPSTREAMS=true

# Optional: DNS query used by dns_cluster for node clustering. Leave blank
# for a single-node deployment.
DNS_CLUSTER_QUERY=
