# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored — never commit real secrets.

# Secret used to sign/encrypt cookies and other secrets. Generate one with:
#   mix phx.gen.secret
SECRET_KEY_BASE=

# Public hostname the app is served from (used for URL generation).
PHX_HOST=localhost

# Port the app listens on inside the container, and the host port it's
# published on (docker-compose maps them 1:1).
PORT=4000

# Ecto/SQLite connection pool size.
POOL_SIZE=5

# Optional: DNS query used by dns_cluster for node clustering. Leave blank
# for a single-node deployment.
DNS_CLUSTER_QUERY=

# Optional: override the command lines for the dashboard's "+ filesystem" /
# "+ fetch" stdio demo servers. The Docker image already bakes in working
# defaults (Node + @modelcontextprotocol/server-filesystem, and a venv with
# mcp-server-fetch), so you normally don't need these. Uncomment to point at
# your own builds instead — a trailing sandbox path is appended to the
# filesystem command automatically. Leave them commented out (an empty value
# would override the image default with a blank).
#   MCP_FILESYSTEM_CMD=/usr/local/bin/node /opt/mcp/filesystem/node_modules/@modelcontextprotocol/server-filesystem/dist/index.js
#   MCP_FETCH_CMD=/opt/mcp/venv/bin/python -m mcp_server_fetch
